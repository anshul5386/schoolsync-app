{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://schoolsync-api-production.up.railway.app"
      }
    },
    "preview": {
      "node": "22.11.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://schoolsync-api-production.up.railway.app",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "pilot": {
      "extends": "preview"
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://schoolsync-api-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
